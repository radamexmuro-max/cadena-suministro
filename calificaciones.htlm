<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Calif</title><style>body{font-family:Arial;background:#0f172a;color:#fff;padding:10px}h1{text-align:center;color:#38bdf8}table{width:100%;background:#fff;color:#000}th{background:#38bdf8;padding:8px}td{padding:6px;text-align:center;border:1px solid #ddd}</style></head><body><h1>Calificaciones 20 Alumnos</h1><table id="t" border="1" style="width:100%"></table><br><input id="nom" placeholder="Nombre"><input id="s1" type="number" placeholder="Sep"><input id="s2" type="number" placeholder="Oct"><input id="s3" type="number" placeholder="Nov"><input id="s4" type="number" placeholder="Dic"><button onclick="agregar()">Agregar</button><script>let alumnos=[["Ana Torres",8,9,9,8],["Luis Garcia",7,6,5,6],["Maria Lopez",10,9,10,9],["Jorge Ruiz",6,5,6,5],["Sofia Diaz",9,9,8,9],["Carlos Muro",8,8,7,8],["Valeria Cruz",10,10,9,10],["Pedro Sanchez",5,6,5,4],["Lucia Reyes",9,8,9,8],["Miguel Angel",7,7,8,7],["Fernanda Ortiz",8,9,8,8],["Diego Ramos",6,6,7,6],["Camila Flores",9,10,9,9],["Javier Mendez",7,8,7,8],["Andrea Gomez",8,8,9,9],["Ricardo Vidal",5,5,6,5],["Paola Jimenez",9,9,9,10],["Emilio Castro",8,7,8,7],["Daniela Vega",10,9,9,10],["Arturo Luna",6,7,6,7]];function mostrar(){let x=document.getElementById("t");x.innerHTML="<tr><th>#</th><th>Alumno</th><th>Sep</th><th>Oct</th><th>Nov</th><th>Dic</th><th>Prom</th><th>Est</th></tr>";alumnos.forEach((a,i)=>{let p=((a[1]+a[2]+a[3]+a[4])/4).toFixed(1);let e=p>=6?"Aprobado":"Reprobado";x.innerHTML+="<tr><td>"+(i+1)+"</td><td>"+a[0]+"</td><td>"+a[1]+"</td><td>"+a[2]+"</td><td>"+a[3]+"</td><td>"+a[4]+"</td><td>"+p+"</td><td>"+e+"</td></tr>";});}function agregar(){let n=nom.value;let v1=parseFloat(s1.value)||0,v2=parseFloat(s2.value)||0,v3=parseFloat(s3.value)||0,v4=parseFloat(s4.value)||0;if(!n)return;alumnos.push([n,v1,v2,v3,v4]);mostrar();}mostrar();</script></body></html>
